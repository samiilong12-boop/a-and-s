# Environment Configuration for A AND S Luxury Perfumes
NODE_ENV=development
PORT=3000

# PostgreSQL Database Connection
# Local Docker Compose: postgresql://postgres:postgres123@localhost:5432/a_and_s_perfume?schema=public
# Or Remote PostgreSQL (Neon/Supabase/Railway):
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/a_and_s_perfume?schema=public"

# Store Configuration (Section 0)
NEXT_PUBLIC_STORE_NAME="A AND S"
NEXT_PUBLIC_STORE_CURRENCY="EGP"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_PIASTERS=100000 # 1000.00 EGP in Piasters

# Authentication & Session Security (E3)
# Generate a 32+ character random string in production
SESSION_SECRET="super-secret-a-and-s-luxury-jwt-token-key-2026-cairo"

# Initial Super Admin (For seed setup)
INITIAL_ADMIN_EMAIL="admin@aandsfragrance.com"
INITIAL_ADMIN_PASSWORD="AdminLuxurySecret2026!"
